# Copy to .env and edit.  Compose reads .env automatically.
#
#     cp .env.example .env
#     echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
#
# (or just run `make env`, which writes those two for you)

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host port for the app.  The container always listens on 8080 as a non-root
# user, so no privileged port is involved.
PORT=8080
# The ML app runs on its own port so it can sit alongside the core one. Set it
# to the same value as PORT (and start only that service) if you want one URL.
ML_PORT=8081
# The GPU app; same image contents as ML but with CUDA torch.
GPU_PORT=8080
DEV_PORT=8080

# ── File ownership ────────────────────────────────────────────────────────────
# Build the image with your own uid/gid so that ./models and anything else you
# bind-mount stays writable, and files the container creates are not root-owned.
# Compose cannot read your shell's $UID, so set it explicitly.
UID=1000
GID=1000

# ── Base image ────────────────────────────────────────────────────────────────
# Point at an internal mirror or a hardened base if you have one.
# BASE_IMAGE=python:3.12-slim

# ── Library ───────────────────────────────────────────────────────────────────
# Source pre-filled in the "New collection" box.  A gs:// URI or a path inside
# the container.  Defaults to NOAA's PIFSC open data, which is world-readable
# and needs no credentials — clear it if you work from your own bucket.
LIB_SOURCE=gs://nmfs_odp_pifsc/PIFSC/ESD/ARP/pifsc-ai-data-repository

# auto = CLIP when it is installed (the `ml` image), else the dependency-free
# hash descriptor.  Force with `clip` or `hash`.
LIB_EMBED_BACKEND=auto

# CLIP weights tag. "random" gives an untrained model for exercising the
# pipeline; an empty value is rejected rather than silently doing the same.
# LIB_CLIP_PRETRAINED=laion2b_s34b_b79k

# auto = Application Default Credentials when present, otherwise an anonymous
# client.  Anonymous is what makes public buckets work with nothing configured.
# Use `no` to require credentials and fail loudly without them.
LIB_GCS_ANONYMOUS=auto

# Detection model: a name Ultralytics can fetch, a path inside the container,
# or a gs:// URI (downloaded into LIB_MODEL_DIR on first use).
# A COCO checkpoint labels reef fish "airplane" — use a domain model:
# LIB_YOLO_MODEL=gs://nmfs_odp_pifsc/PIFSC/ESD/ARP/pifsc-ai-data-repository/models/yolo11-esa-icra-detector.pt
LIB_YOLO_MODEL=yolo11n.pt

# SAM 3 weights are access-gated; download sam3.pt and drop it in ./models.
LIB_SAM3_MODEL=/models/sam3.pt

# Extra models to offer in the picker, comma separated. The UI can only choose
# from this allowlist plus the curated defaults and whatever is in ./models —
# a model reference names a pickle that torch.load executes, so it is never
# accepted straight from the browser.
LIB_EXTRA_MODELS=

# Default regex whose named groups become key:value tags.  Per-source rules set
# with `index --tag-pattern` take precedence over this.
LIB_PATH_TAG_PATTERN=

# Parallel object fetches during a crawl.
LIB_CRAWL_WORKERS=8

# ══ Multi-user stack (docker-compose.stack.yml) ═══════════════════════════════
# deploy/install_oceanframe.sh and deploy/stack_up.sh write all of this for you,
# with generated passwords. Passwords: start with a letter (Oracle requires it).

# ── Oracle Free ───────────────────────────────────────────────────────────────
# ORACLE_PASSWORD=
# APP_SCHEMA_NAME=oceanframe
# APP_SCHEMA_PASSWORD=
# DB_SERVICE_NAME=FREEPDB1
# Loopback-only port for an admin's SQL client; 1522 so CAT's 1521 stays free.
# ORACLE_HOST_PORT=1522

# ── Where the stack keeps data (named volumes unless set to directories) ─────
# OCEANFRAME_ORACLE_DATA=/home/you/oceanframe_data/oracle-data   (owned by uid 54321)
# OCEANFRAME_LIBRARY_DATA=/home/you/oceanframe_data/library
# OCEANFRAME_MODELS=/home/you/oceanframe_data/models
# OCEANFRAME_UPLOADS=/home/you/oceanframe_data/uploads

# ── Serving ───────────────────────────────────────────────────────────────────
# OCEANFRAME_HOST_PORT=8080
# Seconds an idle connection stays open: longer than the Cloud Workstations
# gateway's ~600 s, or saves fail when it reuses one the app just closed.
# APP_KEEPALIVE=650

# ── Sign-in ───────────────────────────────────────────────────────────────────
# on = every page and API needs a sign-in (the stack's default); off = open.
# OCEANFRAME_AUTH=off
# First admin, created once if missing (never overwritten). With sign-in on, set a
# password here or nobody can manage users (the app logs a warning saying so).
OCEANFRAME_ADMIN_USERNAME=admin
OCEANFRAME_ADMIN_PASSWORD=
# OCEANFRAME_ADMIN_EMAIL=
# More accounts made once on first start: username:role:password, comma separated.
# OCEANFRAME_STARTER_USERS=test:lead:Pchange1me,user1:curator:Pchange2me
# OCEANFRAME_SESSION_HOURS=168
# OCEANFRAME_SESSION_COOKIE_SECURE=false
# Refuse cross-site writes. Turn off only if a proxy rewrites Host and every
# save fails with "Cross-site request refused".
# OCEANFRAME_ORIGIN_CHECK=on
# Self-service accounts, as in CAT (on by default); new accounts start as
# SIGNUP_ROLE (curator or viewer). Off: admins create every account.
# OCEANFRAME_ALLOW_SIGNUP=on
# OCEANFRAME_SIGNUP_ROLE=curator

# ── Application database ──────────────────────────────────────────────────────
# `make up` runs Oracle Free (`oceanframe-oracle`); `make env` generates
# ORACLE_PASSWORD and APP_SCHEMA_PASSWORD. To use an existing Oracle instead, set
# OCEANFRAME_DB_DSN=host:port/service with OCEANFRAME_DB_USER/OCEANFRAME_DB_PASSWORD.
# OCEANFRAME_REQUIRE_ORACLE=on refuses to start on SQLite.
# ORACLE_PASSWORD=
# APP_SCHEMA_PASSWORD=
# OCEANFRAME_DB_DSN=
# OCEANFRAME_REQUIRE_ORACLE=on
# Without Oracle (python launch.py): SQLite at $LIB_DATA_DIR/app.sqlite, or a
# SQLAlchemy URL, e.g. oracle+oracledb://user:pass@host:1521/?service_name=FREEPDB1
# OCEANFRAME_DB_URL=
# `make up` and the stack (docker-compose.stack.yml) are alternatives: both run
# oceanframe-oracle on host port 1522, one Oracle at a time. The T3 review
# (docker-compose.t3-review.yml) joins that Oracle's network: oceanframe-local
# under `make up` (the default), oceanframe-net under the stack.
# OCEANFRAME_NETWORK=oceanframe-net
# One coordinator per database: only one app process runs the import and
# evaluation workers. Any other app on the same database sets this off (the T3
# review does).
# OCEANFRAME_BACKGROUND_WORKERS=on

# ── Curation (see docs/CURATION.md) ───────────────────────────────────────────
# Lowest role that may register Hugging Face repos, create projects, import,
# register models and run evaluations (viewer, curator, lead or admin).
# Deleting projects, publishing versions and applying a link stay with leads.
# CURATION_CREATE_ROLE=curator
# A class (or region…) is flagged rare in the split breakdown when val or test
# holds fewer items than this.
# CURATION_RARE_MIN=10
# CURATION_IMAGE_BUCKETS=
# CURATION_IMPORT_SOURCES=
# CURATION_EVAL_DIR=
# Starter data on a new install, pulled in the background when missing:
#   noaa-t3           = the "NOAA Pacific T3" regional project (three PIFSC
#                       regions, ~160 MB) AND the Hugging Face T3 dataset
#                       (as a project) and classifier model (NMFS-OSI)
#   regional | hub    = only one of the two
#   off               = nothing (the code default; docker-compose.yml and the installer
#                       opt in with noaa-t3, so a compose install without this line gets it)
# To keep it off on a compose install, set CURATION_STARTER_DATA=off here: an old
# CURATION_SEED= line (empty) does not, because compose defaults this variable to noaa-t3.
# A starter project you delete stays deleted. Older name: CURATION_SEED=noaa-pacific
# (= regional). The model needs sign-in or CURATION_ALLOW_LOCAL_MODELS.
# CURATION_STARTER_DATA=noaa-t3
# Published versions (see docs/CURATION.md): an optional gs:// copy of each
# version's manifest and change log, and the train/val/test split of new items.
# CURATION_PUBLISH_URI=gs://your-bucket/oceanframe-datasets
# CURATION_SPLIT_RATIOS=0.8,0.1,0.1
# CURATION_SPLIT_SEED=42

# Hugging Face registry (see docs/CURATION.md): public repositories only, pinned
# to a commit. Needs outbound HTTPS from the web container.
# CURATION_HF_ALLOWED_ORGS=NMFS-OSI
# CURATION_HF_ENDPOINT=https://huggingface.co
# CURATION_HUB_CACHE=
# CURATION_HUB_MAX_BYTES=2147483648
# Evaluation staging: parallel patch fetch, share of patches that may stay
# unscored before the run fails, and the patch cache directory ("off" disables).
# CURATION_EVAL_FETCH_WORKERS=32
# CURATION_EVAL_MAX_MISSING=0.05
# CURATION_PATCH_CACHE=
# Local disk cache of source images and cut patches (never written to buckets).
# CURATION_IMAGE_CACHE=/data/library/curation_cache
# CURATION_IMAGE_CACHE_MB=2048
# Model registration and evaluation: the isolated worker
# (docker-compose.evaluation.yml, with the stack) must be running to validate
# and score a model.
# CURATION_TRUSTED_CHECKPOINTS=off
# CURATION_MODEL_MAX_BYTES=1073741824
